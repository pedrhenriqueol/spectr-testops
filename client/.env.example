# Desenvolvimento: o Vite encaminha /api/v1 ao backend local.
SPECTR_API_URL=http://127.0.0.1:3335

# Na Vercel, vercel.json encaminha /api/v1 para spectr-testops-server.onrender.com.
# Não é necessária variável de execução para esse encaminhamento.
# O endereço público opcional abaixo também alimenta o ambiente Local do executor.
# VITE_API_URL=https://spectr-testops-server.onrender.com/api/v1

# Apenas para instalações que precisam dispensar o proxy pela mesma origem:
# VITE_API_TRANSPORT=direct
